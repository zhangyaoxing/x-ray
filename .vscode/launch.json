{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: X-Ray-HC",
            "type": "debugpy",
            "request": "launch",
            "module": "mongo_x_ray",
            "console": "integratedTerminal",
            "justMyCode": false,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "${workspaceFolder}/src"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-ftdc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-ftdc"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-log",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-log"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-gmd",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-gmd"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-hc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-hc"
                }
            ],
            "args": [
                "hc",
                "-s",
                "default",
                "mongodb://localhost:27017/admin?tls=false&connectTimeoutMS=5000",
                // "mongodb://localhost:27027/admin?tls=false&connectTimeoutMS=5000",
                // "mongodb+srv://cluster0.wy1z6.mongodb.net/?appName=Cluster0"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "LOG_LEVEL": "INFO",
                "ENV": "development"
            },
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "App: X-Ray-LOG",
            "type": "debugpy",
            "request": "launch",
            "module": "mongo_x_ray",
            "console": "integratedTerminal",
            "justMyCode": false,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "${workspaceFolder}/src"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-ftdc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-ftdc"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-log",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-log"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-gmd",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-gmd"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-hc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-hc"
                }
            ],
            "args": [
                "-c",
                "src/mongo_x_ray/config.json",
                "log",
                "misc/mongodb.log"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "LOG_LEVEL": "INFO",
                "ENV": "development"
            },
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "App: X-Ray-GMD",
            "type": "debugpy",
            "request": "launch",
            "module": "mongo_x_ray",
            "console": "integratedTerminal",
            "justMyCode": false,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "${workspaceFolder}/src"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-ftdc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-ftdc"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-log",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-log"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-gmd",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-gmd"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-hc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-hc"
                }
            ],
            "args": [
                "-c",
                "src/mongo_x_ray/config.json",
                "gmd",
                "misc/getMongoData-rs.json"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "LOG_LEVEL": "INFO",
                "ENV": "development"
            },
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "App: X-Ray-FTDC",
            "type": "debugpy",
            "request": "launch",
            "module": "mongo_x_ray",
            "console": "integratedTerminal",
            "justMyCode": false,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "${workspaceFolder}/src"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-ftdc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-ftdc"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-log",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-log"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-gmd",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-gmd"
                },
                {
                    "localRoot": "${workspaceFolder}/plugins/mongo-x-ray-hc",
                    "remoteRoot": "${workspaceFolder}/../mongo-x-ray-hc"
                }
            ],
            "args": [
                "-c",
                "src/mongo_x_ray/config.json",
                "ftdc",
                "-f",
                "html",
                "misc/ftdc",
                "2026-08-05T00:00:00",
                "2026-08-06T06:00:00"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "LOG_LEVEL": "INFO",
                "ENV": "development"
            },
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Unit Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-m",
                "not integration"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Integration Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "prepare-test-cluster",
            "postDebugTask": "cluster-teardown",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HC_URI": "mongodb://localhost:47017",
                "GMD_SAMPLE": "${workspaceFolder}/.tests/mongo/getMongoData-output.json",
                "LOG_SAMPLE": "${workspaceFolder}/.tests/mongo/data/replset/rs1/mongod.log",
                "FTDC_SAMPLE": "${workspaceFolder}/.tests/mongo/metrics.final"
            }
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "LOG_LEVEL": "INFO",
                "ENV": "development"
            },
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}